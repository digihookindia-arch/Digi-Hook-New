# Copy to .env.local and fill in. Never commit .env.local.

# ── Public site ──────────────────────────────────────────────────────────────
# Canonical origin. Drives canonical URLs, OpenGraph, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://digihook.in

# ── Proposal dashboard (/dashboard) ──────────────────────────────────────────
# Proposal storage is SQLite (Node's built-in node:sqlite — nothing to install).
# Optional: where the database file lives. Defaults to data/digihook.db.
# SQLITE_PATH=data/digihook.db

# The shared password your team types to sign in. Change it when someone leaves.
DASHBOARD_PASSWORD=

# Signs the session and proposal-access cookies. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# Without RESEND_API_KEY the enquiry is still saved and the dashboard says so
# plainly, but nothing is sent — no acknowledgement to the client, no
# notification to the studio. Get a key at resend.com and verify digihook.in.
RESEND_API_KEY=
# Sender. Must be on a domain the provider has verified.
MAIL_FROM=Digi Hook <sales@digihook.in>
# Where new-enquiry notifications land.
STUDIO_INBOX=sales@digihook.in

# Claude, for drafting and revising proposals. Server-side only — never exposed.
ANTHROPIC_API_KEY=

# Optional cost controls. Default is claude-haiku-4-5 — the cheapest tier, and
# the least capable. Move up if proposal quality suffers:
#   claude-sonnet-5  ~2x the cost of Haiku, much closer to Opus on writing
#   claude-opus-5    ~6x the cost of Haiku, the best drafts
# PROPOSAL_MODEL=claude-sonnet-5
#
# Thinking depth: low | medium | high. Ignored on Haiku, which rejects it.
# PROPOSAL_EFFORT=low
