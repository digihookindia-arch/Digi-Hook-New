# Copy to .env.local and fill in. Never commit .env.local.

# ── Public site ──────────────────────────────────────────────────────────────
# Canonical origin. Drives canonical URLs, OpenGraph, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://digihook.in

# ── Proposal dashboard (/dashboard) ──────────────────────────────────────────
# Proposal storage is SQLite (Node's built-in node:sqlite — nothing to install).
# Optional: where the database file lives. Defaults to data/digihook.db.
# SQLITE_PATH=data/digihook.db

# The shared password your team types to sign in. Change it when someone leaves.
DASHBOARD_PASSWORD=

# Signs the session and proposal-access cookies. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# The studio mailbox lives on Zoho Mail (digihook.in's MX, SPF and DKIM
# records all point at Zoho — check the DNS zone before changing this).
# Sending MUST go through Zoho's SMTP: any other relay fails SPF/DKIM and
# lands in spam even when it authenticates. Without SMTP_USER/SMTP_PASS the
# enquiry is still saved and the dashboard says so plainly, but nothing is
# sent — no acknowledgement to the client, no notification to the studio.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
# The mailbox login. SMTP_PASS is a Zoho *app password*, not the account
# password: Zoho Mail -> Settings -> Security -> App passwords.
SMTP_USER=contact@digihook.in
SMTP_PASS=
# Sender. Must be the same mailbox as SMTP_USER — Hostinger rejects a mismatched From.
MAIL_FROM=Digi Hook <contact@digihook.in>
# Where new-enquiry notifications land.
STUDIO_INBOX=contact@digihook.in

# ── WhatsApp (Cloud API) ─────────────────────────────────────────────────────
# The studio's WhatsApp Business Platform number, for sending the same
# milestone updates email sends. Nothing sends without WHATSAPP_TOKEN — the
# same rule as SMTP above: better to report plainly that it is off than to
# pretend a message went out.
#
# WHATSAPP_TOKEN must be a *System User* token with expiration set to Never.
# The token the developer console offers by default lasts 24 hours, and
# shipping that one means sending stops working the next morning.
# Business Settings → Users → System users → Generate new token, with the
# whatsapp_business_messaging and whatsapp_business_management scopes.
WHATSAPP_TOKEN=
# WhatsApp Manager → Phone numbers, shown beneath the number itself.
WHATSAPP_PHONE_NUMBER_ID=
# Business Settings → Accounts → WhatsApp accounts → the ID under the name.
WHATSAPP_WABA_ID=
# Graph API version. Check the app dashboard for the current default before
# changing this — an unsupported version fails every call with a 400.
WHATSAPP_API_VERSION=v21.0

# ── Client portal · traffic panel (optional) ─────────────────────────────────
# Base URL of the self-hosted GoatCounter's stats vhost. The portal reads each
# project's numbers through /s/<code>/api/... on this origin (nginx maps the
# path onto the site's Host header). Unset hides every traffic panel.
GOATCOUNTER_ORIGIN=https://stats.digihook.in

# ── Client portal · renewal reminders ────────────────────────────────────────
# Guards /api/cron/reminders, which the VPS crontab calls once a day to send
# the 30/15/7/1-day support and server expiry reminders. Unset = the route
# plays dead and nothing is ever sent. Generate like AUTH_SECRET.
# The same secret also guards /api/cron/seo-audit (weekly site audits).
CRON_SECRET=

# ── Client portal · SEO workspace (optional) ─────────────────────────────────
# Path to a Google Cloud service-account JSON key with the Search Console API
# enabled on its project. The portal's SEO tab reads clicks/impressions/CTR/
# position through it — for each client, the key's client_email must be added
# as a user on that property in Search Console (Settings → Users), and the
# property name goes on the project in /dashboard/portal. Unset = the search
# panel says "being connected" and shows no numbers; site audits still run,
# they need no Google access.
# GSC_KEY_FILE=/home/digihook/.gsc-service-account.json

# ── Client portal · Google sign-in (optional) ────────────────────────────────
# "Continue with Google" on /portal/login. Accounts stay invite-only — Google
# only proves which email the visitor owns; an email without an existing
# portal account is turned away, never signed up. Without both values the
# button simply does not render.
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client
# (type: Web application) with this authorised redirect URI:
#   https://digihook.in/portal/google/callback
# (add http://localhost:3000/portal/google/callback for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude, for drafting and revising proposals. Server-side only — never exposed.
ANTHROPIC_API_KEY=

# Optional cost controls. Default is claude-sonnet-5. Haiku is cheaper but
# noticeably weaker at holding the house voice and pricing rules; Opus is the
# best drafts at ~3x Sonnet's cost.
# PROPOSAL_MODEL=claude-opus-5
#
# Thinking depth: low | medium | high. Ignored on Haiku, which rejects it.
# PROPOSAL_EFFORT=medium
