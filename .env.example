# Copy to .env.local and fill in. Never commit .env.local.

# ── Public site ──────────────────────────────────────────────────────────────
# Canonical origin. Drives canonical URLs, OpenGraph, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://digihook.in

# ── Proposal dashboard (/dashboard) ──────────────────────────────────────────
# Proposal storage is SQLite (Node's built-in node:sqlite — nothing to install).
# Optional: where the database file lives. Defaults to data/digihook.db.
# SQLITE_PATH=data/digihook.db

# The shared password your team types to sign in. Change it when someone leaves.
DASHBOARD_PASSWORD=

# Signs the session and proposal-access cookies. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# Sent via the studio's own Hostinger mailbox (SMTP) — digihook.in's DNS
# already carries Hostinger's DKIM/SPF/DMARC records for this mailbox, so
# sending through it rides on authentication that's already verified rather
# than standing up a second provider. Without SMTP_USER/SMTP_PASS the enquiry
# is still saved and the dashboard says so plainly, but nothing is sent — no
# acknowledgement to the client, no notification to the studio.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# The mailbox's own login — same one used for webmail/IMAP.
SMTP_USER=sales@digihook.in
SMTP_PASS=
# Sender. Must be the same mailbox as SMTP_USER — Hostinger rejects a mismatched From.
MAIL_FROM=Digi Hook <sales@digihook.in>
# Where new-enquiry notifications land.
STUDIO_INBOX=sales@digihook.in

# Claude, for drafting and revising proposals. Server-side only — never exposed.
ANTHROPIC_API_KEY=

# Optional cost controls. Default is claude-sonnet-5. Haiku is cheaper but
# noticeably weaker at holding the house voice and pricing rules; Opus is the
# best drafts at ~3x Sonnet's cost.
# PROPOSAL_MODEL=claude-opus-5
#
# Thinking depth: low | medium | high. Ignored on Haiku, which rejects it.
# PROPOSAL_EFFORT=medium
